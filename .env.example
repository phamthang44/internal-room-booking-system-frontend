# Local development: Vite proxies /api to localhost:8080.
VITE_API_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here
# Optional native WebSocket connection in local development.
VITE_STOMP_BROKER_URL=ws://localhost:8080/ws
# Production Docker build receives Google ID and wss URL from backend/.env.prod.
# Do not put secrets in VITE_* variables: they are public browser bundle values.
